# Set in the Cloud Functions environment for codebase default. Not secrets.
# PRIVATE_PARKING_SHEET_ID is the spreadsheet id Nafiu shares with the
# function's runtime service account. PRIVATE_PARKING_SHEET_TAB is the tab name.
PRIVATE_PARKING_SHEET_ID=
PRIVATE_PARKING_SHEET_TAB=
# Override per project. Staging default is also set on the param.
PRIVATE_PARKING_SYNC_SERVICE_ACCOUNT=private-parking-sync@ferro-maps-staging-v2.iam.gserviceaccount.com
# Ferro SURGE spreadsheet id (the long id in the sheet URL). Not a secret.
# syncSurgeSheetEvents is scheduled, and it does not read until this is set.
# Share that sheet with the function's runtime service account as a viewer.
SURGE_SHEET_ID=
SURGE_EVENTS_TAB=Events
SURGE_READINGS_TAB=Readings
# Tabs read by attachCategoryForecasts only. Not secrets. Defaults match the sheet.
SURGE_TPC_LOG_TAB=TPC Disruption Log
SURGE_TPC_READINGS_TAB=TPC Readings
# Proposed tab read by the surge jobs. If the tab is missing, those jobs still
# read the tabs that already exist. Nothing writes Events, Readings, or any other existing tab.
SURGE_CHECK_INS_TAB=Check-ins
# Runtime account for syncHotspotTestPins. Not the Compute Engine default.
# Staging default is also set on the param. Another project overrides this.
# Create the account before deploying this function. Not a secret.
HOTSPOT_TEST_PINS_SYNC_SERVICE_ACCOUNT=hotspot-test-pins-sync@ferro-maps-staging-v2.iam.gserviceaccount.com
# syncHotspotTestPins reads SURGE_SHEET_ID and appends new hotspots_test rows to
# the Hotspot Test Pins tab only. Default true: log the rows, do not write.
# Leave this true until that account can read hotspots_test and is an Editor
# on the surge sheet. The Compute Engine default account stays view-only.
HOTSPOT_TEST_PINS_DRY_RUN=true
