{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "node scripts/deploy-default.cjs",
    "logs": "firebase functions:log",
    "test": "bash scripts/test-play.sh",
    "test:apple": "npm run build && PATH=\"$PATH:../firestore-tests/node_modules/.bin\" firebase emulators:exec --only firestore --project demo-ferromaps-apple --config ../firebase.json \"node --test lib/subscriptions/appleGrant.test.js\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test:run": "tsc -p tsconfig.test.json --noEmit && node --import tsx --test --test-reporter spec test/*.test.ts",
    "test:parking": "firebase emulators:exec --only firestore --project demo-ferromaps-parking \"npm run test:run\"",
    "test:road-charges": "node --import tsx --test --test-reporter spec test/roadCharges.test.ts",
    "seed:road-charges": "node --import tsx src/roadCharges/seedCli.ts"
  },
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@sendgrid/mail": "^8.1.6",
    "busboy": "^1.6.0",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.0",
    "google-auth-library": "^11.3.2",
    "stripe": "^23.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/busboy": "^1.5.4",
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase": "^13.1.0",
    "firebase-functions-test": "^3.4.1",
    "firebase-tools": "^15.34.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.0"
  },
  "private": true
}
